PORT=3001
DATABASE_PATH=penter.db
AI_API_KEY=your-chat-provider-key
AI_API_URL=https://api.groq.com/openai/v1/chat/completions
AI_MODEL=openai/gpt-oss-120b

# Required for Studio Foto AI
AI_IMAGE_API_KEY=your-image-provider-key
AI_IMAGE_API_URL=https://api.openai.com/v1/images/edits
AI_IMAGE_MODEL=gpt-image-1
AI_IMAGE_SIZE=1024x1024

# Optional: use a separate vision provider/model for questions about photos
AI_VISION_API_KEY=your-vision-provider-key
AI_VISION_API_URL=https://api.groq.com/openai/v1/chat/completions
AI_VISION_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
